# Copy to paypal/.env (gitignored, chmod 600). Never paste these in a chat.
# PayPal sandbox app: developer.paypal.com → Apps & Credentials → Sandbox → your app
PAYPAL_MODE=sandbox            # sandbox | mock (mock needs no credentials at all)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# The sandbox PERSONAL account that plays the freelancer (receives the payout)
PAYPAL_FREELANCER_EMAIL=
# The AI seat: Claude. Leave empty to run the seat in mock mode (SEAT_MODE=mock).
ANTHROPIC_API_KEY=
SEAT_MODE=claude               # claude | mock
PAYPAL_PORT=8796
